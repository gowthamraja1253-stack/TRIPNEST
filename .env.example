# ============================================================
# TripNest Environment Variables — Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=tripnestdatabase

# ─── Spring Datasource (overrides application.yml defaults) ─
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tripnestdatabase
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ─── JWT Security ────────────────────────────────────────────
# Generate a secure 256-bit (32-byte) hex string, e.g.:
#   openssl rand -hex 32
APP_JWT_SECRET=your_jwt_secret_here_must_be_at_least_256_bits

# ─── Third-Party API Keys ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
UNSPLASH_API_KEY=your_unsplash_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
